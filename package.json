{
    "name": "@ds-wizard/plugin-sdk",
    "author": "Jan Slifka",
    "license": "MIT",
    "description": "",
    "repository": {
        "url": "git+https://github.com/ds-wizard/dsw-plugin-sdk.git"
    },
    "version": "0.12.0",
    "main": "dist/index.js",
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" && eslint src --fix",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./elements": {
            "types": "./dist/elements/index.d.ts",
            "import": "./dist/elements/index.js"
        },
        "./data": {
            "types": "./dist/data/index.d.ts",
            "import": "./dist/data/index.js"
        },
        "./project-importer": {
            "types": "./dist/project-importer/index.d.ts",
            "import": "./dist/project-importer/index.js"
        },
        "./requests": {
            "types": "./dist/requests/index.d.ts",
            "import": "./dist/requests/index.js"
        },
        "./ui/*": {
            "types": "./dist/ui/*.d.ts",
            "import": "./dist/ui/*.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "import": "./dist/utils/index.js"
        },
        "./types": {
            "types": "./dist/types.d.ts"
        },
        "./protocol": {
            "types": "./dist/protocol.d.ts",
            "import": "./dist/protocol.js"
        },
        "./version": {
            "types": "./dist/version.d.ts",
            "import": "./dist/version.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.5.1",
        "typescript": "~6.0.3"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "zod": "^4.6.5"
    },
    "overrides": {
        "esbuild": "^0.28.2"
    }
}
